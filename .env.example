# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill it in. Never commit .env.local.
#
# Leave both blank while developing: the RSVP form then writes to
# .data/rsvps.jsonl so you can test the whole flow before touching Google.
# ─────────────────────────────────────────────────────────────────────

# The /exec URL of your Apps Script web app.
# See scripts/apps-script.gs for how to get it.
# REQUIRED in production — without it the form returns an honest error
# rather than silently dropping a guest's reply.
RSVP_WEBHOOK_URL=

# Any long random string. Must match SHARED_SECRET inside apps-script.gs.
# Stops anyone who discovers your Apps Script URL from writing to the sheet.
# Generate one with:  node -e "console.log(crypto.randomUUID())"
RSVP_SHARED_SECRET=
